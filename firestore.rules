rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }
    function isTeam() {
      return isSignedIn() && userRole() == 'team';
    }
    function isAdminOrTeam() {
      return isAdmin() || isTeam();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdminOrTeam());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    match /projects/{id} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdminOrTeam());
      allow write: if false;
    }

    match /payments/{id} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdminOrTeam());
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /projectRequests/{id} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdminOrTeam());
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /enquiries/{id} {
      allow read, write: if isAdmin();
      allow create: if true;
    }

    match /wa_enquiries/{id} {
      allow read, write: if isAdmin();
      allow create: if true;
    }
  }
}
